    "@fontsource/inter": "5.2.6"
  },
  "devDependencies": {
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.8.3",
    "vite": "7.3.7",
    "vitest": "4.1.11",
    "playwright-core": "1.56.1"
  }
}
